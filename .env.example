# ============================================================
# SportBook — переменные окружения
# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env НЕ должен попадать в репозиторий (см. .gitignore).
# ============================================================

# URL проекта Supabase (Settings → API → Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Публичный anon-ключ Supabase (Settings → API → anon public)
# ВАЖНО: используйте именно anon (publishable) ключ.
# service_role key НЕЛЬЗЯ использовать на клиенте.
SUPABASE_ANON_KEY=your-anon-key-here